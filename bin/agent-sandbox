#!/usr/bin/env bash
# agent-sandbox — CLI launcher for the microsandbox-based agent sandbox.
#
# Delegates to the TypeScript CLI via bun. The TS CLI provides the full
# subcommand surface: build, create, start, stop, shell, exec, list, remove,
# opencode, codex, doctor, and project management.
#
# This launcher stays as a thin bash wrapper so the CLI is callable from
# anywhere (symlinked to ~/.local/bin etc.) without needing to reference
# the source tree or bun directly.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink "$0" || echo "$0")")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

exec bun run "$PROJECT_DIR/src/cli.ts" "$@"
