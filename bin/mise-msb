#!/bin/sh
# mise-msb launcher — POSIX sh bootstrap.
#
# The `install` command symlinks ~/.local/bin/mise-msb to this file, and
# the shell invokes it directly — so it must not depend on a global bun
# installation. This bootstrap resolves the repo's pinned bun through
# mise (using this repo's mise.toml) and hands off to the TypeScript
# entrypoint.
#
# The caller's working directory is preserved: sandbox config discovery
# is relative to cwd, so we only point mise at the repo config instead
# of cd'ing into the repo.
#
# The loop below resolves the real location of this file through the
# ~/.local/bin symlink (portable — macOS has no `readlink -f`).

SCRIPT=$0
while [ -L "$SCRIPT" ]; do
  LINK=$(readlink "$SCRIPT") || break
  case "$LINK" in
    /*) SCRIPT=$LINK ;;
    *) SCRIPT=$(dirname "$SCRIPT")/$LINK ;;
  esac
done

REPO_ROOT=$(cd "$(dirname "$SCRIPT")/.." && pwd) || {
  echo "mise-msb: cannot locate the repository (resolved launcher: $SCRIPT)" >&2
  exit 1
}

if ! command -v mise >/dev/null 2>&1; then
  echo "mise-msb: mise not found on PATH — install it from https://mise.jdx.dev" >&2
  exit 1
fi

# Pin tool resolution to this repo's mise.toml regardless of cwd so the
# wrapper always runs with the pinned bun (auto-installed on first use).
export MISE_CONFIG_FILE="$REPO_ROOT/mise.toml"

exec mise x bun -- bun "$REPO_ROOT/src/mise-msb.ts" "$@"
