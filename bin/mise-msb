#!/usr/bin/env bun
/**
 * mise-msb launcher.
 *
 * The symlink target installed into ~/.local/bin. Bun shebang ensures the
 * wrapper is invoked directly without `bun run` indirection.
 */

import { dispatch } from "../src/commands/dispatch.js";

await dispatch(process.argv.slice(2)).catch((err: unknown) => {
  const message = err instanceof Error ? err.message : String(err);
  console.error(`mise-msb: ${message}`);
  process.exit(1);
});
