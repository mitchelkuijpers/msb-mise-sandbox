# ~/.bashrc for the agent sandbox container
# Seeded by /usr/local/bin/agent-entrypoint on first container start.
# User modifications after first start are preserved (entrypoint never overwrites).

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# mise activation for interactive shells
# Shims are already on PATH via ENV for non-interactive use;
# activate gives dynamic PATH recalculation per-prompt for interactive shells.
eval "$(mise activate bash)"

# History settings
export HISTSIZE=10000
export HISTFILESIZE=20000
export HISTCONTROL=ignoreboth:erasedups
export HISTTIMEFORMAT='%F %T '

# Shell prompt
PS1='\[\033[01;31m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '

# Aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'

# Editor defaults (vim-tiny provides vi)
export EDITOR=vi
export VISUAL=vi
export PAGER=less
