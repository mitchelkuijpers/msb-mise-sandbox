# SSH server configuration for the agent sandbox.
# Key-only authentication for root. No passwords, no PAM.
# Used by herdr --remote to attach as a thin client.

Port 22
ListenAddress 0.0.0.0

PermitRootLogin prohibit-password
PasswordAuthentication no
PubkeyAuthentication yes
UsePAM no

AuthorizedKeysFile .ssh/authorized_keys

# Disable forwarding we don't need
AllowTcpForwarding no
X11Forwarding no
GatewayPorts no
PermitTunnel no

# Keep connections alive
ClientAliveInterval 30
ClientAliveCountMax 3
