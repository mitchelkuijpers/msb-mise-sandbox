#!/bin/bash
set -e

MAX_WAIT=30
INTERVAL=2

if ! pidof dockerd > /dev/null 2>&1; then
    # /run lives on the persistent root disk, so an unclean VM stop leaves
    # daemon runtime files behind. The recorded PIDs can still exist as
    # unreaped zombies (the microVM init never reaps orphans), and dockerd's
    # liveness checks then treat the old daemon as still running and refuse
    # to start. pidof already proved no dockerd process exists, so removing
    # the stale pidfiles and sockets before launching is safe.
    rm -f /var/run/docker.pid /var/run/docker.sock
    rm -f /var/run/docker/containerd/containerd.pid \
        /var/run/docker/containerd/containerd.sock \
        /var/run/docker/containerd/containerd.sock.ttrpc \
        /var/run/docker/containerd/containerd-debug.sock
    dockerd > /var/log/dockerd.log 2>&1 &
fi

for i in $(seq 1 $MAX_WAIT); do
    if docker info > /dev/null 2>&1; then
        exit 0
    fi
    sleep $INTERVAL
done

echo "docker-up: dockerd did not become ready within $((MAX_WAIT * INTERVAL)) seconds" >&2
echo "docker-up: daemon logs (last 30 lines):" >&2
tail -30 /var/log/dockerd.log 2>/dev/null || true
echo "docker-up: run 'dockerd --debug' manually for more diagnostics" >&2
exit 1
